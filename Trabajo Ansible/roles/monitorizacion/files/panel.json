{
  "annotations": { "list": [] },
  "editable": true,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 1,
      "title": "1. ¿Está vivo?",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus_ds" },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "options": { "0": { "color": "red", "index": 1, "text": "DOWN" }, "1": { "color": "green", "index": 0, "text": "UP" } }, "type": "value" }
          ],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 1 }] }
        }
      },
      "gridPos": { "h": 5, "w": 12, "x": 0, "y": 1 },
      "id": 2,
      "options": { "colorMode": "background", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "textMode": "value_and_name" },
      "targets": [{ "expr": "up", "legendFormat": "{{job}} ({{instance}})", "refId": "A" }],
      "title": "Estado UP de cada Objetivo",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus_ds" },
      "fieldConfig": {
        "defaults": {
          "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "yellow", "value": 1 }, { "color": "green", "value": 2 }] }
        }
      },
      "gridPos": { "h": 5, "w": 6, "x": 12, "y": 1 },
      "id": 3,
      "options": { "colorMode": "background", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false } },
      "targets": [
        { "expr": "dfs_fs_namesystem_state_num_live_data_nodes", "legendFormat": "DataNodes Vivos", "refId": "A" },
        { "expr": "dfs_fs_namesystem_state_num_dead_data_nodes", "legendFormat": "DataNodes Muertos", "refId": "B" }
      ],
      "title": "HDFS DataNodes Vivos / Muertos",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus_ds" },
      "fieldConfig": {
        "defaults": {
          "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "yellow", "value": 1 }, { "color": "green", "value": 2 }] }
        }
      },
      "gridPos": { "h": 5, "w": 6, "x": 18, "y": 1 },
      "id": 4,
      "options": { "colorMode": "background", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false } },
      "targets": [
        { "expr": "metrics_master_aliveWorkers_Value", "legendFormat": "Spark Workers Vivos", "refId": "A" }
      ],
      "title": "Spark Workers Vivos",
      "type": "stat"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 6 },
      "id": 5,
      "title": "2. ¿Van justos los recursos?",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus_ds" },
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "max": 100 } },
      "gridPos": { "h": 7, "w": 8, "x": 0, "y": 7 },
      "id": 6,
      "targets": [
        { "expr": "100 * (1 - avg by (instance) (rate(node_cpu_seconds_total{mode=\"idle\"}[1m])))", "legendFormat": "CPU {{instance}}", "refId": "A" },
        { "expr": "100 * avg by (instance) (rate(node_cpu_seconds_total{mode=\"steal\"}[1m]))", "legendFormat": "Steal {{instance}}", "refId": "B" }
      ],
      "title": "CPU y Steal por VM (%)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus_ds" },
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "max": 100 } },
      "gridPos": { "h": 7, "w": 8, "x": 8, "y": 7 },
      "id": 7,
      "targets": [
        { "expr": "100 * (1 - (node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes))", "legendFormat": "RAM {{instance}}", "refId": "A" }
      ],
      "title": "Memoria RAM por VM (%)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus_ds" },
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "max": 100 } },
      "gridPos": { "h": 7, "w": 8, "x": 16, "y": 7 },
      "id": 8,
      "targets": [
        { "expr": "100 * (1 - (node_filesystem_avail_bytes{mountpoint=\"/\"} / node_filesystem_size_bytes{mountpoint=\"/\"}))", "legendFormat": "Disco / {{instance}}", "refId": "A" }
      ],
      "title": "Disco Raíz por VM (%)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus_ds" },
      "fieldConfig": { "defaults": { "unit": "percent" } },
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 14 },
      "id": 9,
      "targets": [
        { "expr": "sum by (instance, name) (rate(container_cpu_usage_seconds_total{name!=\"\"}[1m])) * 100", "legendFormat": "{{name}} ({{instance}})", "refId": "A" }
      ],
      "title": "CPU por Contenedor (%)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus_ds" },
      "fieldConfig": { "defaults": { "unit": "bytes" } },
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 14 },
      "id": 10,
      "targets": [
        { "expr": "sum by (instance, name) (container_memory_working_set_bytes{name!=\"\"})", "legendFormat": "{{name}} ({{instance}})", "refId": "A" }
      ],
      "title": "Memoria por Contenedor",
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 21 },
      "id": 11,
      "title": "3. ¿Cómo está HDFS?",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus_ds" },
      "fieldConfig": { "defaults": { "unit": "bytes" } },
      "gridPos": { "h": 7, "w": 16, "x": 0, "y": 22 },
      "id": 12,
      "targets": [
        { "expr": "dfs_fs_namesystem_state_capacity_used", "legendFormat": "Capacidad Usada", "refId": "A" },
        { "expr": "dfs_fs_namesystem_state_capacity_remaining", "legendFormat": "Capacidad Libre", "refId": "B" }
      ],
      "title": "Capacidad Usada y Libre en HDFS",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus_ds" },
      "fieldConfig": { "defaults": {} },
      "gridPos": { "h": 7, "w": 8, "x": 16, "y": 22 },
      "id": 13,
      "targets": [
        { "expr": "dfs_fs_namesystem_state_under_replicated_blocks", "legendFormat": "Bloques Sub-replicados", "refId": "A" }
      ],
      "title": "Bloques Sub-replicados en HDFS",
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 29 },
      "id": 14,
      "title": "4. ¿Qué está haciendo Spark?",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus_ds" },
      "fieldConfig": { "defaults": {} },
      "gridPos": { "h": 7, "w": 8, "x": 0, "y": 30 },
      "id": 15,
      "options": { "colorMode": "value", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false } },
      "targets": [
        { "expr": "metrics_master_apps_Value", "legendFormat": "Apps en ejecución", "refId": "A" }
      ],
      "title": "Aplicaciones Spark en Ejecución",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus_ds" },
      "fieldConfig": { "defaults": { "unit": "percent" } },
      "gridPos": { "h": 7, "w": 16, "x": 8, "y": 30 },
      "id": 16,
      "targets": [
        { "expr": "sum by (instance, name) (rate(container_cpu_usage_seconds_total{name=~\".*spark.*\"}[1m])) * 100", "legendFormat": "{{name}} ({{instance}})", "refId": "A" }
      ],
      "title": "Uso de CPU de Spark (%)",
      "type": "timeseries"
    }
  ],
  "refresh": "10s",
  "schemaVersion": 39,
  "title": "Clúster Big Data",
  "uid": "cluster-big-data",
  "version": 1
}